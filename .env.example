# Port for local development
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret key required to access admin endpoints (POST/PUT/DELETE /api/projects)
# Change this to a secure random string in production!
ADMIN_KEY=arshiya-portfolio-admin-secret-2026

# Allowed CORS Origins (use * for all or comma-separated list of origins)
CORS_ORIGIN=*
